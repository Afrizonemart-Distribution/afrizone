# Production build settings for the portal. Committed on purpose: these are
# public values (they end up in the shipped JavaScript anyway), and the portal
# is uploaded by hand (`wrangler pages deploy dist`), so a build that forgot
# to set them would quietly ship the wrong API or hide Continue with AfriZone.
# See .env.production.example for what each one means. NO SECRETS HERE.

VITE_API_URL=https://api.parttime.afrizonemart.com

# Continue with AfriZone on the sign-in page (server flag AFRIZONE_LOGIN_ENABLED is on).
VITE_AFRIZONE_LOGIN=true
