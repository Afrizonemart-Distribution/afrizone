// Afrizone Part Time: Prisma schema
//
// Production target: Cloudflare D1 (SQLite-based), via the @prisma/adapter-d1
// driver adapter - see src/prisma.ts. Local dev also runs on SQLite (DATABASE_URL),
// so this schema needs no changes between the two; only the Prisma Client
// instantiation differs (adapter-bound vs a plain DATABASE_URL connection).
//
// Prisma Migrate does not support D1 yet, so schema changes are applied via:
//   npx prisma migrate diff --from-empty --to-schema ./prisma/schema.prisma \
//     --script --output migrations/000X_name.sql
//   npx wrangler d1 migrations apply <db-name> --local   (or --remote)
// rather than `prisma migrate dev`/`db push` for the D1 database itself.
// Local SQLite dev (DATABASE_URL) keeps using `prisma db push` as before.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// NOTE ON ENUMS: SQLite does not support native enums, so enum-typed columns
// are stored as `String`. The allowed values live as TS union types in
// src/types.ts and are validated in the route handlers. On Postgres these can
// become real `enum` blocks.
//
// NOTE ON `tiers`: SQLite does not support scalar lists (`Tier[]`), so a
// worker's tiers are stored as a single comma-separated String (e.g.
// "PROMO,DISPATCH"). The API always exposes `tiers` as a real string[] array.
// Helpers tiersToString / tiersToArray in src/types.ts do the conversion.

model User {
  id                String   @id @default(cuid())
  name              String
  email             String   @unique
  phone             String?  @unique // worker OTP login (E.164, e.g. +2348030000001)
  passwordHash      String? // nullable: workers are passwordless (phone OTP)
  totpSecret        String? // pending or active TOTP secret (RFC 6238)
  totpEnabled       Boolean  @default(false)
  googleId          String?  @unique // Google SSO subject (admin)
  role              String   @default("WORKER") // Role enum
  /// INDIVIDUAL | STORE | COURIER - what kind of outside party this account is.
  ///
  /// A SEPARATE AXIS FROM `role`, deliberately. `role` mixes Afrizone staff
  /// (SUPER_ADMIN, TASK_MANAGER, HR_ADMIN) with one participant value (WORKER);
  /// adding STORE and COURIER to that enum would merge "who works at Afrizone"
  /// with "what kind of outside party you are", and every existing requireRole
  /// guard would have to be re-reasoned. Two fields leaves all of them alone.
  ///
  /// Defaults INDIVIDUAL and is NOT NULL, which is a trade made with open eyes:
  /// an admin row will carry INDIVIDUAL, which is not true of them. Nothing
  /// reads accountType for admin routes - those are gated on `role` - so the
  /// value is inert there, and the alternative (nullable) costs NULL handling
  /// at every read plus a window where accounts created between this migration
  /// and the code that sets the field would have no type at all.
  accountType       String   @default("INDIVIDUAL")
  tiers             String   @default("") // comma-separated Tier[]: see note above
  kycStatus         String   @default("PENDING") // KycStatus enum
  kycNote           String? // latest verification note (auto-reject reason from Smile ID, or admin note)
  location          String?
  rating            Float?
  completedCount    Int      @default(0)
  bankMasked        String?
  bankAccountNumber String? // real payout account (NUBAN): required for live Paystack transfers
  bankCode          String? // Paystack bank code, e.g. "058" (GTBank)
  bankName          String?
  tin               String? // Tax Identification Number: stored from KYC / profile edit
  pushToken         String? // Expo push token (ExponentPushToken[...]): updated on each login
  notifTasks        Boolean  @default(true) // push: task matches & approval status changes
  notifPay          Boolean  @default(true) // push: payment releases & withdrawal updates
  notifEmail        Boolean  @default(false) // email summary digest (future)
  createdAt         DateTime @default(now())

  tasksCreated        Task[]               @relation("TaskCreatedBy")
  applications        Application[]
  timesheets          Timesheet[]
  payments            Payment[]
  auditLogs           AuditLog[]
  clockEvents         ClockEvent[]
  withdrawals         Withdrawal[]
  fundingsInitiated   Funding[]
  contracts           Contract[]
  passwordResets      PasswordReset[]
  kycDocuments        KycDocument[]
  kycVerifications    KycVerification[]
  disputes            Dispute[]
  ratingsReceived     Rating[]             @relation("WorkerRatings")
  ratingsGiven        Rating[]             @relation("RatingsGiven")
  notifications       Notification[]
  skills              WorkerSkill[]
  courierProfile      CourierProfile?
  courierPresence     CourierPresence?
  evidence            Evidence[]
  credentials         Credential[]         @relation("WorkerCredentials")
  credentialsReviewed Credential[]         @relation("CredentialsReviewed")
  orgMemberships      OrganizationMember[]
  commitments         Commitment[]         @relation("WorkerCommitments")
  auditsCarriedOut    StoreAudit[]         @relation("AuditorAudits")
}

model Task {
  id             String   @id @default(cuid())
  title          String
  description    String
  category       String
  tier           String // Tier enum
  payModel       String // PayModel enum (HOURLY | FIXED)
  rate           Int? // ₦/hour for HOURLY
  budget         Int? // fixed ₦ for FIXED
  startDate      DateTime
  endDate        DateTime
  locationType   String // LocationType enum (PHYSICAL | REMOTE)
  address        String?
  lat            Float? // task site latitude : required for real geofence check
  lng            Float? // task site longitude: required for real geofence check
  geofenceRadius Int      @default(100)
  slots          Int
  status         String   @default("OPEN") // TaskStatus enum
  deadline       DateTime
  createdById    String
  createdAt      DateTime @default(now())

  /// GENERAL | STORE_AUDIT | DELIVERY | SOURCING | MEDIA - Blueprint §12's
  /// `type`. Defaults GENERAL, which is what every task that existed before
  /// this column was.
  ///
  /// This is deliberately NOT `category`, which is a free-text label an admin
  /// types and which drives nothing. `kind` is what code branches on, and the
  /// two must not be conflated: renaming a category should never change
  /// behaviour.
  kind String @default("GENERAL")

  /// The business this task is ABOUT, when it is about one - the store being
  /// audited, or later the store an order is collected from. Not who created
  /// it and not who is paid for it.
  organizationId String?

  // ── Requirements (Phase 4) ──
  //
  // DEFAULTS FALSE, deliberately. Defaulting true would silently gate every
  // task already live in the pilot the moment this ships. The admin form
  // defaults the toggle ON for NEW tasks, which is a different thing and is
  // safe: a person is choosing it, on a task nobody has applied to yet.
  requiresIdentityVerified Boolean @default(false)
  // Denormalised one-line summary for list cards. NEVER used to decide
  // anything - a stale string on a card is harmless, telling a worker the
  // wrong reason they are blocked is not.
  requirementsSummary      String?
  // Bumped whenever requirements change, so a cached summary or a stored
  // eligibility snapshot can be recognised as belonging to an older shape.
  requirementsVersion      Int     @default(0)

  createdBy    User          @relation("TaskCreatedBy", fields: [createdById], references: [id])
  applications Application[]
  timesheets   Timesheet[]
  payments     Payment[]
  clockEvents  ClockEvent[]
  contracts    Contract[]
  ratings      Rating[]

  skillRequirements      TaskSkillRequirement[]
  credentialRequirements TaskCredentialRequirement[]
  organization           Organization?               @relation(fields: [organizationId], references: [id])
  storeAudits            StoreAudit[]
  /// The order this posting exists to deliver, when it is a DELIVERY task.
  /// At most one: a delivery posting has one slot and one order behind it.
  delivery               Delivery?
  evidence               Evidence[]

  @@index([status])
  /// "Which audit tasks are open?" and "what is this store's task?" are both
  /// lookups the admin approval screen makes.
  @@index([kind, organizationId])
}

// Requirements are two narrow join tables rather than one polymorphic table or
// a JSON column. Two reasons, both practical rather than aesthetic:
//
//  - the live qualifying-count an admin sees while building a task has to be
//    index-usable, and a JSON blob is not;
//  - "which open tasks require this skill?" has to be answerable when an admin
//    retires a skill, and a polymorphic table makes that a scan with a type
//    discriminator instead of a plain indexed lookup.
model TaskSkillRequirement {
  id      String @id @default(cuid())
  taskId  String
  skillId String

  task  Task  @relation(fields: [taskId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([taskId, skillId])
  @@index([skillId])
}

model TaskCredentialRequirement {
  id               String @id @default(cuid())
  taskId           String
  credentialTypeId String

  task           Task           @relation(fields: [taskId], references: [id])
  credentialType CredentialType @relation(fields: [credentialTypeId], references: [id])

  @@unique([taskId, credentialTypeId])
  @@index([credentialTypeId])
}

model Application {
  id                  String   @id @default(cuid())
  taskId              String
  workerId            String
  pitch               String?
  status              String   @default("APPLIED") // AppStatus enum
  reason              String?
  // What was true about this worker when the application was accepted, as
  // JSON. Credentials expire, so "were they eligible at the time?" cannot be
  // reconstructed later from current state - and that is exactly the question
  // asked when something goes wrong on a job.
  eligibilitySnapshot String?
  createdAt           DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id])
  worker User @relation(fields: [workerId], references: [id])

  @@index([taskId, status])
  @@index([workerId, status])
  @@index([taskId, workerId])
}

model Timesheet {
  id          String   @id @default(cuid())
  taskId      String
  workerId    String
  periodStart DateTime
  periodEnd   DateTime
  hours       Float
  status      String   @default("SUBMITTED") // TimesheetStatus enum
  gpsNote     String?
  createdAt   DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id])
  worker User @relation(fields: [workerId], references: [id])

  @@index([status])
  @@index([workerId])
}

model Payment {
  id        String   @id @default(cuid())
  workerId  String
  taskId    String
  gross     Int
  whtRate   Float    @default(0.05)
  whtAmount Int
  net       Int
  status    String   @default("PENDING") // PaymentStatus enum
  createdAt DateTime @default(now())

  worker User @relation(fields: [workerId], references: [id])
  task   Task @relation(fields: [taskId], references: [id])

  @@index([status])
  @@index([workerId])
}

model AuditLog {
  id        String   @id @default(cuid())
  // Nullable: an automated actor has no User row. actorId was REQUIRED and
  // FK'd to User, so any system-initiated action failed its audit insert
  // outright - which blocks every webhook, scheduled job and integration in
  // the roadmap from being auditable at all.
  actorId   String?
  actorType String   @default("USER") // ActorType: USER | SYSTEM | WEBHOOK | JOB | INTEGRATION
  actorRef  String? // identifies a non-USER actor, e.g. "paystack"
  action    String
  entity    String
  entityId  String
  meta      String? // JSON serialized as String (SQLite has no Json type)
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
  @@index([actorId])
}

// ── v2: Hiring ────────────────────────────────────────────────────────────────

model Job {
  id             String   @id @default(cuid())
  title          String
  department     String
  location       String
  employmentType String // EmploymentType enum (FULL_TIME | PART_TIME | CONTRACT)
  salaryMin      Int?
  salaryMax      Int?
  description    String
  needsCv        Boolean  @default(true)
  needsCover     Boolean  @default(false)
  needsPortfolio Boolean  @default(false)
  closingDate    DateTime
  status         String   @default("OPEN") // JobStatus enum (OPEN | CLOSED)
  createdById    String
  createdAt      DateTime @default(now())

  candidates JobApplication[]
}

model JobApplication {
  id        String   @id @default(cuid())
  jobId     String
  name      String
  email     String
  phone     String?
  stage     String   @default("SCREENING") // Stage enum
  cvNote    String?
  rating    Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  job Job @relation(fields: [jobId], references: [id])
}

// ── v2: Settings ──────────────────────────────────────────────────────────────

model TaxRate {
  id           String  @id @default(cuid())
  jurisdiction String // e.g. "Federal", "Lagos"
  category     String // e.g. "Services", "default"
  whtRate      Float
  vatRate      Float
  active       Boolean @default(true)
}

model Category {
  id              String  @id @default(cuid())
  name            String
  tier            String // Tier enum
  defaultPayModel String // PayModel enum (HOURLY | FIXED)
  active          Boolean @default(true)
}

model Setting {
  key   String @id @unique
  value String // String/JSON value
}

// ── v3: Worker-facing (mobile app) ──────────────────────────────────────────

model ClockEvent {
  id          String   @id @default(cuid())
  workerId    String
  taskId      String
  type        String // ClockType enum (IN | OUT)
  lat         Float?
  lng         Float?
  withinFence Boolean
  note        String?
  createdAt   DateTime @default(now())

  worker User @relation(fields: [workerId], references: [id])
  task   Task @relation(fields: [taskId], references: [id])

  @@index([workerId, taskId, createdAt])
}

model Withdrawal {
  id            String   @id @default(cuid())
  workerId      String
  amount        Int
  bankMasked    String
  status        String   @default("PROCESSING") // WithdrawalStatus enum (PROCESSING | PAID | FAILED)
  provider      String? // "paystack" | "simulated"
  reference     String?  @unique // our idempotency key, also sent to Paystack
  providerRef   String? // Paystack transfer_code
  failureReason String?
  createdAt     DateTime @default(now())

  worker User @relation(fields: [workerId], references: [id])
}

// Platform-level inbound funding (Afrizone Mart topping up the balance that
// worker withdrawals draw from). Mirrors Withdrawal's shape/lifecycle. The
// running platform balance is derived (Σ SUCCESS fundings − Σ non-failed
// withdrawals), not stored: same "derive, don't store" convention as the
// per-worker wallet in wallet.ts.
model Funding {
  id          String   @id @default(cuid())
  amount      Int
  status      String   @default("PENDING") // FundingStatus enum (PENDING | SUCCESS | FAILED)
  provider    String? // "paystack" | "simulated"
  reference   String   @unique // our idempotency key, also sent to Paystack
  providerRef String? // Paystack transaction access_code
  initiatedBy String
  createdAt   DateTime @default(now())

  admin User @relation(fields: [initiatedBy], references: [id])
}

model Contract {
  id            String    @id @default(cuid())
  taskId        String
  workerId      String
  /// The WORK lifecycle for this Tasker on this Task - Blueprint §4.2, and see
  /// services/contractState.ts for the legal transitions. NOT the signature
  /// state: whether somebody signed is read from signedAt below, because how far
  /// the work has got is a different question and holding both here meant a
  /// signed contract could not say whether anyone had started.
  status        String    @default("CLAIMED")
  signedAt      DateTime?
  signerName    String? // typed full-name signature, captured at sign time (record of intent)
  signerIp      String? // requesting IP at sign time
  signatureHash String? // SHA-256 of `${contractId}:${workerId}:${signerName}:${signedAt.toISOString()}`, for tamper-evidence
  createdAt     DateTime  @default(now())

  task        Task         @relation(fields: [taskId], references: [id])
  worker      User         @relation(fields: [workerId], references: [id])
  commitments Commitment[]

  @@index([taskId, workerId])
  @@index([workerId])
}

// ── Auth: phone OTP + password reset (hashed at rest, single-use, time-boxed) ──

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  // HMAC-SHA256(server pepper, "salt:phone:purpose:code") - see routes/authOtp.ts.
  // Was an unsalted sha256 of the six digits alone, which is reversible by
  // anyone who can read this table: 10^6 values precompute to a few megabytes.
  codeHash   String
  // Per-row random salt. Nullable only so the column could be added without a
  // backfill; rows written since always carry one, and a row without one can no
  // longer be verified against (its digest scheme no longer exists).
  codeSalt   String?
  purpose    String    @default("login") // OtpPurpose enum (login)
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String // sha256 of the reset token
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

/// A rating on one engagement. Blueprint §9 wants these two-way: Afrizone or the
/// store rates the Tasker, and the Tasker rates the experience back.
model Rating {
  id        String @id @default(cuid())
  /// The worker involved in this engagement - the SAME person in both
  /// directions. They are the subject when direction is OF_WORKER and the
  /// author when it is OF_EXPERIENCE, which is why this is not called
  /// `subjectId`.
  workerId  String
  taskId    String
  /// OF_WORKER: Afrizone or the store rating the Tasker.
  /// OF_EXPERIENCE: the Tasker rating the job back.
  ///
  /// Defaults OF_WORKER, which is not merely convenient - every row that
  /// existed before this column was exactly that.
  direction String @default("OF_WORKER")

  score       Int // 1–5 stars
  note        String?
  createdById String
  createdAt   DateTime @default(now())

  worker    User @relation("WorkerRatings", fields: [workerId], references: [id])
  task      Task @relation(fields: [taskId], references: [id])
  createdBy User @relation("RatingsGiven", fields: [createdById], references: [id])

  /// One rating each way per engagement. The old constraint was
  /// (workerId, taskId), which allowed only one rating full stop and is what
  /// made two-way impossible.
  @@unique([workerId, taskId, direction])
  @@index([workerId])
}

model Dispute {
  id          String   @id @default(cuid())
  workerId    String
  entityType  String // PAYMENT | TIMESHEET
  entityId    String
  reason      String
  status      String   @default("OPEN") // DisputeStatus: OPEN | RESOLVED | CLOSED
  resolution  String? // admin note when resolving / closing
  // Status of the disputed Payment/Timesheet at the moment the dispute was
  // raised, so closing the dispute restores it instead of guessing. Nullable
  // for rows created before this column existed - those fall back to APPROVED,
  // the old hard-coded behaviour.
  priorStatus String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  worker User @relation(fields: [workerId], references: [id])

  @@index([workerId])
  @@index([entityId])
}

model KycDocument {
  id           String   @id @default(cuid())
  userId       String
  docType      String // "ID" | "SELFIE" | "DOCS"
  filename     String // stored filename on disk
  originalName String?
  mimeType     String?
  path         String // absolute path on disk
  createdAt    DateTime @default(now())

  user        User         @relation(fields: [userId], references: [id])
  // A credential's evidence is stored through this same pipeline.
  credentials Credential[]

  @@index([userId])
}

model KycVerification {
  id         String   @id @default(cuid())
  workerId   String
  jobId      String   @unique // our id, sent to Smile as partner_params.job_id
  smileJobId String? // Smile's SmileJobID, once assigned
  status     String   @default("PENDING") // PENDING | APPROVED | REJECTED | ERROR
  resultCode String?
  resultText String?
  raw        String? // JSON of the last Smile ID response, for audit/debugging
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  worker User @relation(fields: [workerId], references: [id])

  @@index([workerId])
}

// ── In-app notification inbox ─────────────────────────────────────────────────

// The DURABLE record of everything the platform tells a worker. Push delivery
// is best-effort and silently fails - a worker who declined the notification
// permission once received nothing, forever, and nobody found out. Since these
// messages now include things that cost a worker money or standing (a rejected
// credential, an application decision, a released payment), the record has to
// exist independently of whether a push ever arrived.
//
// Written by notifyWorker/notifyWorkers in services/push.ts, which every
// notifying route already goes through - so the record is created at the same
// single choke point rather than at each call site.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  // The deep-link payload, e.g. {"screen":"wallet"}. JSON serialised as a
  // String, as elsewhere in this schema - SQLite has no Json type.
  data      String?
  readAt    DateTime? // null = unread
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  // The inbox list: one worker's notifications, newest first.
  @@index([userId, createdAt])
  // The unread badge, which is polled far more often than the list is opened.
  @@index([userId, readAt])
}

// ── Talent profile: skills and credentials ───────────────────────────────────
//
// The distinction between these two is the whole design, and it is deliberate:
//
//   SKILLS are self-declared and carry NO verification state whatsoever. They
//   are for search, ranking and admin judgement. They never gate anything.
//   A "checked by us" badge on a skill that unlocks nothing is a promise the
//   interface makes and the eligibility engine breaks, so the badge does not
//   exist - and neither does the column behind it.
//
//   CREDENTIALS are the things that can be guaranteed, because a person looked
//   at a document and said so. Anything that must gate access is modelled as a
//   credential type, never as a skill.

// The Afrizone-controlled catalogue of skills a worker can declare.
model Skill {
  id        String  @id @default(cuid())
  name      String
  // Stable identifier for code and imports. `name` is deliberately NOT unique:
  // renaming a skill must never orphan the rows pointing at it.
  slug      String  @unique
  group     String // e.g. "Logistics", "Retail" - how the picker is grouped
  active    Boolean @default(true) // soft-retire; rows are never hard-deleted
  sortOrder Int     @default(0)

  createdAt DateTime @default(now())

  workers    WorkerSkill[]
  requiredBy TaskSkillRequirement[]
}

model WorkerSkill {
  id       String @id @default(cuid())
  workerId String
  skillId  String
  years    Int? // optional self-reported experience

  createdAt DateTime @default(now())

  worker User  @relation(fields: [workerId], references: [id])
  skill  Skill @relation(fields: [skillId], references: [id])

  @@unique([workerId, skillId])
  @@index([skillId])
}

// The Afrizone-controlled catalogue of credential types.
model CredentialType {
  id                String  @id @default(cuid())
  name              String
  slug              String  @unique
  // ADMIN_REVIEW: a person checks the document before it counts.
  // SELF_DECLARED: recorded on the worker's word alone.
  reviewMode        String  @default("ADMIN_REVIEW")
  // THIRD_PARTY: issued by someone else, evidenced by their document.
  // AFRIZONE: issued by Afrizone itself, evidenced by platform history - the
  // route by which a competent worker with no formal paper can still pass a
  // gate. Without it the platform could only ever ratify credentials people
  // already had.
  issuerMode        String  @default("THIRD_PARTY")
  requiresExpiry    Boolean @default(false)
  requiresReference Boolean @default(false)
  requiresFile      Boolean @default(true)
  issuerHint        String? // e.g. "FRSC" - shown as placeholder text
  active            Boolean @default(true)
  sortOrder         Int     @default(0)

  createdAt DateTime @default(now())

  credentials Credential[]
  requiredBy  TaskCredentialRequirement[]
}

model Credential {
  id               String    @id @default(cuid())
  workerId         String
  credentialTypeId String
  title            String
  issuer           String?
  referenceNumber  String?
  issuedAt         DateTime?
  expiresAt        DateTime?
  // The uploaded evidence, via the same KYC document pipeline.
  documentId       String?
  // PENDING | VERIFIED | REJECTED | REVOKED.
  //
  // There is deliberately NO stored EXPIRED status. Expiry is computed at read
  // time - VERIFIED and (expiresAt is null or expiresAt > now) - so a
  // background job that fails to run can never leave a lapsed licence reading
  // as valid. A status that decays with the clock must not be a stored value.
  status           String    @default("PENDING")
  reviewedById     String?
  reviewedAt       DateTime?
  rejectionReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  worker         User           @relation("WorkerCredentials", fields: [workerId], references: [id])
  credentialType CredentialType @relation(fields: [credentialTypeId], references: [id])
  document       KycDocument?   @relation(fields: [documentId], references: [id])
  reviewedBy     User?          @relation("CredentialsReviewed", fields: [reviewedById], references: [id])

  // The review queue, and the "expiring soon" filter.
  @@index([credentialTypeId, status, expiresAt])
  // One worker's credentials, and the eligibility check in Phase 4.
  @@index([workerId, status])
}

// ── Organizations: AfriZoneMart stores and courier companies ─────────────────

/// A business that works with Afrizone: a store that fulfils orders, or a
/// courier company whose riders deliver them.
///
/// ONE MODEL WITH A `kind`, NOT TWO TABLES. Both need exactly the same things -
/// several staff who log in as themselves, one bank account belonging to the
/// business rather than to any employee, one location, and an Afrizone approval
/// gate. Building them separately means writing membership, approval,
/// verification and payout twice and then maintaining two of each. What differs
/// between a store and a courier company is what they DO, which lives in the
/// routes and the work they receive, not in who they are.
///
/// An individual courier is NOT an Organization. Someone delivering on their own
/// bike is a plain User with accountType COURIER and no business behind them, so
/// every flow that touches a courier has to work for a bare user as well as for
/// an org member. That is a real cost, taken deliberately: the alternative is a
/// one-person "organization" wrapped around every rider, which is a fiction the
/// payout and approval flows would then have to keep up.
model Organization {
  id   String @id @default(cuid())
  /// STORE | COURIER. What kind of business this is.
  kind String @default("STORE")
  name String
  /// Stable identifier for code, imports and the AfriZoneMart side of the
  /// integration. `name` is deliberately NOT unique - renaming must never
  /// orphan the rows pointing at it (same rule as Skill.slug).
  slug String @unique

  phone   String?
  email   String?
  address String?
  lat     Float?
  lng     Float?

  /// Payout details live HERE, not on any member's User row. Money owed goes to
  /// the business regardless of which staff member touched the work, and a
  /// member leaving must not take the payout account with them.
  bankAccountNumber String?
  bankCode          String?
  bankName          String?
  bankMasked        String?
  tin               String?

  /// CAC registration - Nigeria's company registry (Blueprint §15).
  ///
  /// A STATUS, NOT A BOOLEAN. `cacVerified` cannot express the state a real
  /// queue spends most of its time in - supplied, not yet decided - and a store
  /// waiting for review would be indistinguishable from one that never gave a
  /// number. Those need different people to act on them.
  ///
  /// UNVERIFIED | PENDING | VERIFIED | REJECTED. Defaults UNVERIFIED, which is
  /// the honest value for every row that predates the check, and **gates
  /// nothing today** - stores are live in the pilot without a number, and a
  /// column added on Tuesday must not suspend them on Wednesday.
  /// Unique where present. SQLite counts NULLs as distinct, so stores without
  /// a number are unaffected by the constraint.
  cacNumber    String?   @unique
  cacStatus    String    @default("UNVERIFIED")
  /// The name the registry returns, which is the whole reason to check a number
  /// rather than merely store it. A mismatch against `name` is shown to the
  /// reviewer as a warning and never actioned automatically: "Mama Nkechi
  /// Provisions" against "M. NKECHI PROVISIONS LTD" is the normal case.
  cacName      String?
  cacCheckedAt DateTime?
  cacNote      String?

  /// PENDING | ACTIVE | SUSPENDED.
  ///
  /// Defaults PENDING: a business must be approved by Afrizone before it can
  /// receive work. One that could take orders the moment somebody typed its
  /// name in would be a hole, not a convenience.
  status String @default("PENDING")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     OrganizationMember[]
  commitments Commitment[]
  tasks       Task[]
  audits      StoreAudit[]
  deliveries  Delivery[]

  /// "Which stores are live?" and "which courier companies are waiting for
  /// approval?" are both list screens, and both filter on exactly this pair.
  @@index([kind, status])
  /// The CAC review queue filters on exactly this.
  @@index([cacStatus])
}

/// Which people may act for which business.
///
/// A join table rather than `User.organizationId` because the relationship is
/// genuinely many-to-many: one person can run more than one branch, and a rider
/// can work for two companies. A column would force a migration the first time
/// that happens and would make "which business am I acting as?" unanswerable
/// rather than merely awkward.
///
/// The unique pair is what makes the row-level guard cheap: "is this user a
/// member of THIS organization" is one indexed lookup, which is the question
/// every org-scoped endpoint has to ask (see util/organization.ts).
model OrganizationMember {
  id             String @id @default(cuid())
  organizationId String
  userId         String

  /// OWNER | STAFF. OWNER may manage members and the payout account; STAFF does
  /// the work - shelf staff in a store, a rider in a courier company.
  /// Deliberately separate from User.role, which is about Afrizone staff, and
  /// from User.accountType, which is about what kind of party the person is.
  /// This one is about standing WITHIN one business.
  role String @default("STAFF")

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  /// "Which businesses can this person act for?" - the sign-in picker.
  @@index([userId])
}

/// Money ring-fenced against a piece of work. Blueprint §10's escrow.
///
/// AFRIZONE PART-TIME NEVER HOLDS THE MONEY. AfriZoneMart holds it throughout;
/// this row records that a specific amount is committed to a specific
/// engagement, and that it became payable on acceptance. The worker-facing
/// promise is identical to custodial escrow - their pay is ring-fenced the
/// moment the contract goes live - while Part-Time stays a ledger rather than a
/// regulated payments business. See MART_INTEGRATION.md §7.
///
/// WHY THIS IS NOT Payment. Payment is created at acceptance, is worker-only,
/// and carries withholding tax because it is wages. A Commitment is created
/// when the contract goes LIVE, can be owed to an organization as easily as a
/// person, and carries no tax because a store selling goods is not earning
/// wages. They coexist: the Commitment is the promise, the Payment is the wage
/// calculation.
model Commitment {
  id String @id @default(cuid())

  /// COMMITTED | RELEASED | PAID | CANCELLED. Transitions in
  /// services/commitmentState.ts, which is the only thing that should move one.
  status String @default("COMMITTED")

  /// Who is owed. EXACTLY ONE of these is set - a commitment owed to nobody, or
  /// to two parties, is a bug rather than a state.
  workerId       String?
  organizationId String?

  /// What it is owed for. At most one.
  contractId  String?
  /// An AfriZoneMart order, for store fulfilment that has no Contract behind it.
  martOrderId String?

  /// Whole Naira, and NULLABLE on purpose.
  ///
  /// A FIXED task has a budget, so the ring-fence is exact from the start. An
  /// HOURLY one cannot be known until hours are submitted, so it is committed
  /// with no figure and trued up on acceptance. Inventing an estimate would put
  /// a number in front of a worker that nobody promised them.
  amount Int?

  /// TASK_PAY | ORDER_FULFILMENT | DELIVERY_FEE | RETAINER
  reason String
  note   String?

  committedAt DateTime  @default(now())
  releasedAt  DateTime?
  paidAt      DateTime?
  cancelledAt DateTime?

  worker       User?         @relation("WorkerCommitments", fields: [workerId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])
  contract     Contract?     @relation(fields: [contractId], references: [id])

  /// One commitment per engagement per reason: a contract must not accumulate
  /// duplicate ring-fences because an endpoint was retried.
  @@unique([contractId, reason])
  /// "What is ring-fenced for me?" - the wallet asks this on every load.
  @@index([workerId, status])
  @@index([organizationId, status])
}

/// The result of somebody physically visiting a store (Blueprint §8).
///
/// A store goes apply -> audit -> approve -> live on the map, and this is the
/// middle step made durable: a qualified Auditor visits, scores the premises,
/// and their finding is what an admin approves or refuses on. Without a row like
/// this, "why was this store approved?" is answerable only by whoever clicked.
///
/// The audit is itself a Task - it is paid work that has to be claimed by
/// somebody carrying an auditor credential - so this row records the OUTCOME and
/// the Task records the work.
model StoreAudit {
  id             String  @id @default(cuid())
  organizationId String
  /// The inspection task an Auditor claimed. Nullable because an admin may
  /// record an audit they carried out themselves without generating one.
  taskId         String?
  auditorId      String?

  /// 0-100. Blueprint §8 asks the premises to be "verified and scored".
  score   Int
  /// PASS | FAIL. Kept separate from the score on purpose: the threshold is a
  /// policy that will move, and a stored outcome means an old audit still says
  /// what it meant when it was made.
  outcome String
  notes   String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  task         Task?        @relation(fields: [taskId], references: [id])
  auditor      User?        @relation("AuditorAudits", fields: [auditorId], references: [id])

  /// "What is the latest finding for this store?" - the question the admin
  /// approval screen asks every time it loads.
  @@index([organizationId, createdAt])
}

/// Every fact AfriZoneMart has told us, and what we did about it.
///
/// Blueprint §5: Mart emits events, PartTime subscribes and runs task-generation
/// rules. This is the ledger of that subscription, and it exists for three
/// separate reasons - only the first is obvious:
///
///   IDEMPOTENCY. Mart retries on a timeout or a 500, and a retry must be free.
///   `eventId` is unique, so a repeat is recognised rather than re-processed.
///
///   NOTHING IS LOST WHILE DOWNSTREAM WORK IS UNBUILT. An order.confirmed today
///   creates no dispatch task, because delivery does not exist yet. Recording it
///   as DEFERRED means those orders can be replayed the day it does, instead of
///   having been dropped on the floor with a 200.
///
///   ANSWERING "WHY IS THERE NO TASK FOR THIS?". Without a row per event, the
///   difference between "Mart never sent it", "we de-duplicated it" and "no rule
///   matched" is invisible, and every one of those is a different bug.
model MartEvent {
  id String @id @default(cuid())

  /// Mart's own idempotency key for this delivery.
  eventId String @unique
  /// order.confirmed | stock.low | store.applied | listing.needs_media
  type    String

  occurredAt DateTime
  receivedAt DateTime @default(now())

  /// The raw payload as sent. Kept verbatim rather than parsed into columns: a
  /// replay has to see exactly what arrived, and a schema that has since moved
  /// on must not silently reinterpret an old event.
  payload String

  /// PROCESSED - work was created.
  /// DEFERRED  - understood, but the thing that would handle it is not built.
  /// IGNORED   - de-duplicated, or no rule matched.
  /// FAILED    - could not be processed.
  status       String  @default("PROCESSED")
  /// The task this event produced, when it produced one.
  resultTaskId String?
  note         String?

  /// "What has Mart sent that we did nothing with?" is the question an operator
  /// asks when something is missing, and it filters on exactly this pair.
  @@index([type, status])
  @@index([receivedAt])
}

/// The vehicle a courier actually rides (Blueprint §3.2).
///
/// What a courier has that a Tasker does not is a vehicle, and everything that
/// follows from one - a licence, papers, insurance. Those three are already
/// `Credential` rows: reviewed by a person, expiring on their own schedule, and
/// gating work through the eligibility engine. This is the vehicle itself,
/// which had nowhere to live.
///
/// ON THE USER, NOT THE ORGANIZATION. A rider on their own bike has no
/// organization at all, and a company's rider still rides one specific machine
/// with one plate. Hanging this off the business would leave independents - the
/// majority - with nowhere to record it, and make a company's fleet a list
/// nobody can attribute to whoever is carrying the parcel.
model CourierProfile {
  id     String @id @default(cuid())
  userId String @unique

  /// MOTORCYCLE | TRICYCLE | CAR | VAN | BICYCLE | FOOT.
  ///
  /// FOOT is not a joke entry. Inner-city drops on foot are real work, and a
  /// courier forced to invent a vehicle to finish sign-up will type something
  /// false into the plate field, which is worse than the truth.
  vehicleType String
  /// Null where the vehicle has no plate - which FOOT and BICYCLE never do.
  /// Unique where present: two couriers cannot be riding the same machine.
  plateNumber String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

/// One photo a worker took to show the work was done (Blueprint §14,
/// services/evidence.ts).
///
/// WHERE AND WHEN COME WITH IT, AND ARE CHECKED ON ARRIVAL. The photo alone
/// proves little; a photo taken at the shop, during the job, is most of what a
/// reviewer would otherwise phone somebody to ask. So the position and the time
/// are stored with every one, the distance from the site is worked out when it
/// arrives, and anything that does not add up is written down as a flag in
/// words a reviewer can act on. A flag never refuses the photo - GPS drifts and
/// phones lie about the time - it only tells a person where to look.
///
/// The bytes live in R2 under evidence/<objectKey>; this row is what says whose
/// they are and who may see them.
model Evidence {
  id       String @id @default(cuid())
  taskId   String
  workerId String

  /// PICKUP | DROPOFF | CLOCK_IN | CLOCK_OUT | WORK | AUDIT - the moment in the
  /// job this photo is for. What each task kind requires is in
  /// services/evidence.ts, not here.
  stage String

  /// Server-generated, never from the client. Unique so one object is never
  /// claimed by two rows.
  objectKey   String @unique
  /// The SNIFFED type, never the declared one - it is served back as a header.
  contentType String
  sizeBytes   Int

  lat            Float?
  lng            Float?
  /// The phone's own estimate of how far off its fix is, in metres.
  accuracyMetres Float?
  /// When the phone says the photo was taken. Device-reported: it is compared
  /// with when it arrived, and a gap is a flag, not a rejection.
  capturedAt     DateTime?

  /// From the site this stage is checked against - the shop for a pickup, the
  /// door for a drop-off, the task's own location otherwise. Null when either
  /// end has no position.
  distanceMetres Float?
  /// JSON array of sentences, one per check that failed. Null or "[]" means
  /// every check passed.
  flags          String?

  /// The clock event this photo was taken for, once used. Unique, so one photo
  /// cannot clock somebody in twice.
  clockEventId String? @unique

  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id])
  worker User @relation(fields: [workerId], references: [id])

  /// "What has this worker shown for this stage of this job?" - every gate
  /// asks exactly this.
  @@index([taskId, workerId, stage])
  /// The upload quota counts on this.
  @@index([workerId, createdAt])
}

/// A courier who is online, and where they last were (services/ranking.ts).
///
/// THE ONLY STORED COURIER POSITION ON THE PLATFORM, and it is held as tightly
/// as it can be while still answering "who is nearest?" before anybody asks.
/// One row per courier, overwritten in place, so there is never a trail - only
/// the latest point. Going offline deletes the row. A row whose `seenAt` is
/// older than PRESENCE_TTL_MINUTES counts as offline at read time and is
/// deleted by the per-minute cron, so a phone that dies, or a courier who
/// forgets to go offline, does not stay on the map.
///
/// Not shown to staff, stores or other couriers. It is read for one purpose:
/// deciding who gets an order first.
model CourierPresence {
  userId String @id

  lat Float
  lng Float

  /// When this online session began. Not a position history.
  onlineSince DateTime @default(now())
  /// The last heartbeat. Whether this row is live is arithmetic on this.
  seenAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The sweep deletes on exactly this.
  @@index([seenAt])
}


/// One Mart order, from confirmed to delivered (MART_INTEGRATION.md §3.1, §4).
///
/// This is what `order.confirmed` becomes. Everything Mart sends about an order
/// lands here; what the work is worth and who may do it comes from
/// `rules.DELIVERY`, not from the payload - see services/taskRules.ts.
///
/// A THIRD STATUS AXIS, AND WHY IT HAS TO BE. `Task.status` is the posting.
/// `Contract.status` is one person's engagement with it. Neither can hold "the
/// store has not accepted this yet" - a state that exists before any courier
/// does and can end the order without one. Overloading a courier's work
/// lifecycle with a shop's decision would make "did the rider fail, or did the
/// store refuse?" unanswerable, and those need different people to act on them.
model Delivery {
  id String @id @default(cuid())

  /// Mart's order number, and the de-duplication key: one order, one fulfilment
  /// job, forever. Deliberately not the event id - Mart may re-confirm an order
  /// under a new one, and that must find this row rather than make a second.
  martOrderId String @unique

  /// The store fulfilling, resolved from `fulfilment.storeSlug` at intake.
  organizationId String
  /// The courier posting, once there is one. Null until the store accepts:
  /// posting work to collect from a shop that has not agreed to pack it sends a
  /// rider to a closed door.
  taskId         String? @unique

  /// CONSIGNMENT | OWN_STOCK - the field the integration document exists for.
  /// It decides whether the store is owed a settlement line, PartTime cannot
  /// infer it, and an absent value is rejected rather than defaulted.
  stockSource String
  /// The line items as sent, JSON, verbatim. PartTime never reasons about them;
  /// it hands a courier a list.
  items       String @default("[]")

  /// Copied from the store at intake, not joined. A store that moves or is
  /// renamed must not rewrite where deliveries already made actually went.
  pickupAddress String?
  pickupLat     Float?
  pickupLng     Float?

  /// Nullable, which is not the same as optional: an order with no destination
  /// is refused at intake. It is nullable because §5 commits us to DELETING the
  /// customer's door seven days after the order finishes, and a NOT NULL column
  /// would force the purge to write a placeholder instead. The coordinates are
  /// optional for a different reason - a rider can find a street name, and a
  /// wrong pin is worse than no pin.
  dropoffAddress      String?
  dropoffLat          Float?
  dropoffLng          Float?
  dropoffInstructions String?

  /// The whole of what §5 permits us to hold about somebody with no PartTime
  /// account. Nullable because the purge empties them, not because they start
  /// absent.
  customerName     String?
  customerPhone    String?
  /// When the purge ran. Not a "hidden" flag - the columns above are actually
  /// emptied - so a purge that never ran is distinguishable from one that ran
  /// and found nothing.
  customerPurgedAt DateTime?

  /// Whole Naira. `deliveryFee` is what MART charged the customer and is NOT
  /// what the courier is paid: that comes from `rules.DELIVERY.fee`, which an
  /// admin sets. Mart changing its pricing must never change our payroll.
  goodsTotal  Int       @default(0)
  deliveryFee Int       @default(0)
  expectedBy  DateTime?

  /// RECEIVED | STORE_ACCEPTED | PREPARED | COURIER_ASSIGNED | PICKED_UP |
  /// DELIVERED | STORE_REJECTED | FAILED | CANCELLED. Legal moves live in
  /// services/delivery.ts.
  status String @default("RECEIVED")

  /// One timestamp per leg rather than a status-history table. "How long did
  /// the store take" and "how long did it sit unclaimed" are the questions
  /// operations actually asks, and they are arithmetic here. The full trail is
  /// in AuditLog, which every transition writes to.
  storeDecidedAt DateTime?
  storeNote      String?
  preparedAt     DateTime?
  /// When this order went onto the board for couriers, and NULL once one holds
  /// it. Not derivable from anything else: `Task.createdAt` is when the posting
  /// was first minted, and a re-opened order (§6 D5) reuses that same posting,
  /// so after one courier vanishes `createdAt` would say the order had been
  /// waiting since before the courier who abandoned it ever took it. Every
  /// escalation number in services/deliveryOffer.ts is arithmetic on this, so a
  /// wrong value here is a circle that opens too wide and an operations board
  /// flagging orders that only just arrived.
  offeredAt      DateTime?
  /// Who gets this order first, best first, frozen when it goes on the board
  /// (services/ranking.ts). JSON: [{ workerId, score, distanceMetres }].
  /// Null or "[]" means nobody was online to rank, and the order goes straight
  /// to the open circle. Whose turn it is is arithmetic on `offeredAt`, the same
  /// way the circle is - see services/deliveryOffer.ts.
  rankedCandidates String?
  /// How many of those candidates have been told it is their turn. The only
  /// thing about the ranked phase that is stored rather than derived, because a
  /// push notification is an event, not a state: the per-minute cron uses it so
  /// nobody is told twice.
  rankedNotified   Int       @default(0)
  /// Seconds of ranked windows cut short by couriers who passed. Added to the
  /// clock the turns are read from, so a pass moves the order straight to the
  /// next candidate without anything becoming a queue. Escalation still reads
  /// the real time waited. Reset with the ranking on a re-open.
  rankedSkippedSeconds Int     @default(0)
  assignedAt     DateTime?
  pickedUpAt     DateTime?
  deliveredAt    DateTime?
  failedAt       DateTime?
  failureReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  task         Task?        @relation(fields: [taskId], references: [id])

  /// "What is waiting on my store?" - the portal queue is exactly this pair.
  @@index([organizationId, status])
  /// "What is stuck?" - the operations board, across every store.
  @@index([status])
  /// The purge sweeps finished orders by age; without this it is a full scan
  /// that grows for as long as the platform runs.
  @@index([status, updatedAt])
  /// "What is on the board, and how long has it been there?" - the operations
  /// board's escalation view, and the same reasoning about scans applies.
  @@index([status, offeredAt])
}
