{
  "name": "afrizone-server",
  "version": "1.0.0",
  "description": "Afrizone Part Time: gig platform backend (Express + Prisma + SQLite)",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "seed": "ts-node-dev --transpile-only prisma/seed.ts",
    "reference:sql": "ts-node-dev --transpile-only scripts/reference-sql.ts",
    "prisma:push": "prisma db push",
    "prisma:generate": "prisma generate",
    "setup": "prisma generate && prisma db push && npm run seed",
    "test": "vitest run"
  },
  "prisma": {
    "seed": "ts-node-dev --transpile-only prisma/seed.ts"
  },
  "overrides": {
    "iconv-lite": "^0.7.3"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@prisma/adapter-d1": "^5.22.0",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^9.15.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "otplib": "^12.0.1",
    "qrcode": "^1.5.4",
    "smile-identity-core": "^3.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.9",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.22.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0"
  }
}
