{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "afrizone-api",
  "main": "src/index.ts",
  // Set this to today's date when bumping.
  "compatibility_date": "2026-08-14",
  "compatibility_flags": ["nodejs_compat"],
  // Plain (non-secret) config, checked in so it survives every deploy - the
  // dashboard-only "Variables and Secrets" UI doesn't reliably persist across
  // Workers Builds deploys (see JWT_SECRET's deploy history). Real secrets
  // (JWT_SECRET, PAYSTACK_SECRET, etc.) still go through `wrangler secret put`
  // or the dashboard's Secret type, never here.
  "vars": {
    // Cloudflare Workers do NOT set NODE_ENV, and it was absent here - so
    // process.env.NODE_ENV was undefined in production. Every developer gate
    // was written as `NODE_ENV !== "production"`, which meant they were all
    // ACTIVE in production: a fixed master OTP code, a password-reset token
    // returned in the API response, and a fixed TOTP code that defeated 2FA.
    // The gates have since been inverted to require an explicit opt-in
    // (see src/env.ts), so this var is now defence in depth rather than the
    // only thing standing between production and those bypasses. Set it
    // anyway: libraries also branch on it, and it should never be undefined.
    "NODE_ENV": "production",
    // Partime-specific hostnames only - never api.afrizonemart.com or
    // admin.afrizonemart.com, which belong to Afrizoma's separate
    // e-commerce infrastructure. See the api.parttime.afrizonemart.com /
    // admin.parttime.afrizonemart.com Worker/Pages custom domains.
    // Two audiences, two origins. admin.* is Afrizone staff; portal.* is the
    // store and courier facing app, which is a separate Pages project on
    // purpose - one deploy must not be able to break the other's users.
    //
    // The .pages.dev entries are the projects' own preview hostnames, kept so a
    // deployment can be checked before its custom domain is pointed at it.
    "CORS_ORIGIN": "https://admin.parttime.afrizonemart.com,https://afrizone.pages.dev,https://portal.parttime.afrizonemart.com,https://afrizone-portal.pages.dev",
    "WEB_ADMIN_URL": "https://admin.parttime.afrizonemart.com",
    // OAuth client IDs are public identifiers, not secrets (they already ship
    // inside the mobile app bundle) - safe to check in, unlike GOOGLE_*
    // client *secrets*, which this app never needs (ID-token verification
    // only). All four from a dedicated "afrizone-part-time" Google Cloud
    // project (499781649562) - never the shared Afrizoma project's client
    // ids. GOOGLE_ANDROID_CLIENT_ID is registered against the local debug
    // keystore's SHA-1, so it's valid for dev/testing builds only; a real
    // Play Store release build will need its own separate Android client
    // registered against the EAS-managed release keystore.
    "GOOGLE_WEB_CLIENT_ID": "499781649562-7p27mo45qt0u172oj4i8i7eh4ru08h1f.apps.googleusercontent.com",
    "GOOGLE_IOS_CLIENT_ID": "499781649562-fe1l2p2hibinhv1ohf1qegkeo4h57890.apps.googleusercontent.com",
    "GOOGLE_ANDROID_CLIENT_ID": "499781649562-31b6frc4u68q87j9l07p95fqag576f9g.apps.googleusercontent.com",
    "GOOGLE_EXPO_CLIENT_ID": "499781649562-ssvksjgvd5580p3307dkuc2qn6komvmb.apps.googleusercontent.com",
    // Provider name only, not a secret - inert until TERMII_API_KEY (a real
    // secret, set separately via `wrangler secret put`) is also present;
    // sms.ts's `enabled` check requires both. No mobile screen currently
    // calls the phone-OTP endpoints (removed in the dove-design rebuild), so
    // this has no visible effect yet either way - wired for whenever that
    // screen comes back.
    "SMS_PROVIDER": "termii",
    // The sender ID Termii sends from. Not a secret - it is the name that
    // appears on the recipient's handset, and Termii must have approved the
    // exact string or it rejects the send.
    //
    // sms.ts already falls back to this same value, so setting it changes no
    // behaviour today. It is here to be VISIBLE: the fallback is buried in a
    // service file, and the next person to get a different sender ID approved
    // would have had no reason to look there.
    "TERMII_FROM": "Afrizone",
    // Continue with AfriZone (routes/authAfrizone.ts). Not a secret: verification uses
    // AfriZone's PUBLIC key from its JWKS. Set to "false" to switch the routes off (503).
    "AFRIZONE_LOGIN_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "afrizone-db",
      "database_id": "a2cf117c-cb5e-4187-8dad-bd16eef49dce"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "afrizone-kyc-docs"
    }
  ],
  // The daily entry: MART_INTEGRATION.md §5 commits us to
  // deleting a delivery customer's name, number and door seven days after the
  // order finishes, and an absence of data is the one thing that cannot be
  // derived at read time the way expired postings and credentials are.
  //
  // Daily, at an odd minute rather than on the hour: Cloudflare queues a great
  // many crons at :00, and there is nothing about this that needs to be in that
  // crowd. Missing a run is safe - the sweep works from a cutoff rather than
  // from "since last time" - so an hour of drift costs nothing.
  //
  // The second entry is ranked delivery offers (services/ranking.ts): each
  // minute, tell the next courier it is their turn and drop couriers whose app
  // stopped sending heartbeats. src/index.ts matches on this exact string.
  "triggers": {
    "crons": ["17 3 * * *", "* * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
