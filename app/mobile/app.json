{
  "expo": {
    "name": "AfriZone PartTime",
    "slug": "afrizone-part-time",
    "owner": "afrizone",
    "scheme": "afrizone",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#F7F7F7",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "work.afrizone.parttime"
    },
    "android": {
      "package": "work.afrizone.parttime",
      "adaptiveIcon": {
        "backgroundColor": "#000066"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-mark-reversed.png",
          "backgroundColor": "#000066",
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "eas": {
        "projectId": "107eeac3-119c-4eba-ab6c-134a5b6c5e4c"
      },
      "googleWebClientId": "",
      "googleIosClientId": "",
      "googleAndroidClientId": "",
      "googleExpoClientId": "",
      "router": {}
    }
  }
}
